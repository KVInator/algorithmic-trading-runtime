if(NOT DEFINED PROGRAM OR NOT DEFINED ROOT)
    message(FATAL_ERROR "Recovery contracts require PROGRAM and ROOT")
endif()
execute_process(COMMAND "${PROGRAM}" "${ROOT}/contracts" RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Journal contracts failed: ${result}")
endif()
foreach(phase before_append after_sync torn_tail after_return)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
    set(run "${ROOT}/${phase}-${suffix}")
    if(EXISTS "${run}")
        message(FATAL_ERROR "Crash fixture directory already exists")
    endif()
    file(MAKE_DIRECTORY "${run}")
    execute_process(COMMAND "${PROGRAM}" --crash "${run}" "${phase}" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Abrupt process fixture failed: ${phase}: ${result}")
    endif()
    execute_process(COMMAND "${PROGRAM}" --verify-crash "${run}" "${phase}" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Restart verification failed: ${phase}: ${result}")
    endif()
endforeach()
